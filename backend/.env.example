# 실행 환경 (development | production)
NODE_ENV=development

# 서버 포트
PORT=3000

# PostgreSQL 연결 문자열
DATABASE_URL=postgresql://postgres:1234@localhost:5432/todolist_dev

# JWT 서명 시크릿 (HS-512 알고리즘 고정)
JWT_SECRET=your-jwt-secret-here

# JWT 만료 시간 (예: 7d, 24h, 3600)
JWT_EXPIRES_IN=7d

# CORS 허용 출처
CORS_ORIGIN=http://localhost:5173
